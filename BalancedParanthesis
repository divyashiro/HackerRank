		        Boolean flag = false;
		        String x = "[{}()]";
				   String[] s = x.split("");
				   Stack<String> stack = new Stack<>();
				   for(int i = 0; i< s.length; i++ ) {
					   if (s[i].equals("[") || s[i].equals("{") || s[i].equals("(")) {
						   stack.push(s[i]);
					   }
					   
					  
					   if (s[i].equals("]") || s[i].equals("}") || s[i].equals(")")) {
						   if((s[i] == "]" && stack.peek()!= "[") || 
								   (s[i] == "}" && stack.peek()!= "{") ||
								   (s[i] == ")" && stack.peek()!= "(")) {
							   flag = false;
						   } else
							   stack.pop();
					   }
					   
					   if (stack.isEmpty())
						   flag =  true;
				   }
				  System.out.println(flag);
				    
