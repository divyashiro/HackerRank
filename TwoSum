public static void main(String[] args) {
		int target = 8;
		List<Integer> twoSum = Arrays.asList(2,6,3,8,9,5);
		//Output = {{2,6},{3,5}}
        Map<Integer,Integer> output = new HashMap<>();
		twoSum.forEach(x -> {
			if (twoSum.contains(target - x)) {
				if(!output.containsKey(target - x))
				output.put(x,target - x );
			}
		});
		output.forEach((key, value) -> System.out.println(key + "," + value));
		
	}
